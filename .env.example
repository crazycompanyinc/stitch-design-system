# Environment Variables for Stitch Design System
# Copy this to .env and fill in your values

# Google Gemini API Key (for Stitch + NanoBanana)
# Get yours at: https://aistudio.google.com/app/apikey
# IMPORTANTE: La API key necesita facturación habilitada en el proyecto GCP
# Ve a: https://console.cloud.google.com/billing
STITCH_API_KEY=your_api_key_here

# Modelos disponibles:
# - gemini-2.0-flash (para generación de código HTML/CSS/JS)
# - gemini-2.5-flash-image (para imágenes)
# - nano-banana-pro-preview (para imágenes de alta calidad)
# - imagen-4.0-generate-001 (para imágenes de alta resolución)

# GitHub Token (para deploy)
GITHUB_TOKEN=your_github_token_here

# Vercel Token (para deploy)
VERCEL_TOKEN=your_vercel_token_here
